# ---------------------------------------------------------------------------
# Enterprise Knowledge Copilot — configuration template.
# Copy to `.env` and edit. Every value below has a working default, so the app
# runs with NO configuration at all (it falls back to the offline extractive
# answerer). Never commit a real key.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# auto      : pick the first provider that is actually configured/reachable
#             (openai_compatible -> gemini -> ollama -> extractive)
# ollama    : free, fully local (https://ollama.com) — recommended for a
#             zero-cost, zero-key demo with a real LLM
# gemini    : Google AI Studio free tier
# openai_compatible : any OpenAI-style /v1 endpoint (Groq free tier, OpenAI,
#             LM Studio, OpenRouter, vLLM ...)
# extractive: no LLM at all. Deterministic, citation-only answers built from
#             retrieved passages. Always available; used for offline CI.
COPILOT_LLM_PROVIDER=auto

# --- Ollama (local, free) --------------------------------------------------
COPILOT_OLLAMA_BASE_URL=http://localhost:11434
COPILOT_OLLAMA_MODEL=llama3.1:8b

# --- OpenAI-compatible endpoint -------------------------------------------
# Groq free tier example:
#   COPILOT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   COPILOT_OPENAI_MODEL=llama-3.3-70b-versatile
COPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
COPILOT_OPENAI_MODEL=gpt-4o-mini
# Read from OPENAI_API_KEY if COPILOT_OPENAI_API_KEY is unset.
COPILOT_OPENAI_API_KEY=

# --- Google Gemini (free tier) --------------------------------------------
COPILOT_GEMINI_MODEL=gemini-2.0-flash
COPILOT_GEMINI_API_KEY=

# --- Generation ------------------------------------------------------------
COPILOT_TEMPERATURE=0.1
COPILOT_MAX_OUTPUT_TOKENS=800
COPILOT_LLM_TIMEOUT_SECONDS=45
COPILOT_LLM_MAX_RETRIES=2

# --- Retrieval -------------------------------------------------------------
COPILOT_TOP_K=5
COPILOT_CANDIDATE_K=20
COPILOT_MIN_RETRIEVAL_SCORE=0.12
COPILOT_CHUNK_TOKENS=220
COPILOT_CHUNK_OVERLAP_TOKENS=45

# --- Conversation ----------------------------------------------------------
COPILOT_HISTORY_TURNS=6
COPILOT_SESSION_TTL_MINUTES=120

# --- Governance ------------------------------------------------------------
COPILOT_REDACT_PII_IN_LOGS=true
COPILOT_ENABLE_TOOLS=true
COPILOT_REQUIRE_GROUNDING=true

# --- Paths (relative to repo root) ----------------------------------------
COPILOT_KNOWLEDGE_BASE_DIR=data/knowledge_base
COPILOT_HR_RECORDS_DIR=data/hr_records
COPILOT_STATE_DIR=var
